<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   xmlns:vm="clr-namespace:<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   xmlns:vm="clr-namespace:AtelierCartes .VuesModeles"
   x:Class="AtelierCartes .Vues.ConnexionPage"
   x:DataType="vm:ConnexionVueModele"
   Title="Connexion">
<ScrollView>
    <VerticalStackLayout Padding="24" Spacing="14">
        <Label Text="Mes cartes automobiles"
                  FontSize="24" FontAttributes="Bold" />
        <Entry Placeholder="Identifiant"
                  Text="{Binding Identifiant}" />
        <Entry Placeholder="Mot de passe"
                  IsPassword="True"
                  Text="{Binding MotDePasse}" />
        <Button Text="Se connecter"
                   IsEnabled="{Binding EstDisponible}"
                   Command="{Binding SeConnecterCommand}" />
        <ActivityIndicator
               IsRunning="{Binding EstOccupe}"
               IsVisible="{Binding EstOccupe}" />
        <Label Text="{Binding Message}" />
    </VerticalStackLayout>
</ScrollView>
</ContentPage>

.VuesModeles"
   x:Class="TestVoiture.Vues.ConnexionPage"
   x:DataType="vm:ConnexionVueModele"
   Title="Connexion">
